# ============================================================
# Render Environment Variables Configuration
# ============================================================

# 1. رابط قاعدة بيانات MongoDB (Atlas أو خارجي)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/jusour?retryWrites=true&w=majority

# 2. رابط الفرونت اند (الخاص بهذه النسخة)
FRONTEND_URL=https://your-frontend-domain.com

# 3. رابط الداشبورد (الخاص بهذه النسخة)
DASHBOARD_URL=https://your-dashboard-domain.com

# 4. بيانات دخول المشرف للداشبورد (يتم إنشاؤها/تحديثها تلقائياً عند تشغيل السيرفر)
ADMIN_USER=admin
ADMIN_PASS=ChangeMeStrongPassword123

# 5. (اختياري) معرف النسخة لعزل البيانات في MongoDB.
# إذا تُرك فارغاً، يقوم السيرفر تلقائياً بتوليد معرّف فريد بناءً على رابط الفرونت اند والداشبورد
# بحيث لا تتداخل بيانات أي نسخة مع نسخة أخرى حتى لو استخدمت نفس رابط MONGODB_URI.
INSTANCE_ID=

